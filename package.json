{
  "name": "dsh-atomcode",
  "displayName": "DSH AtomCode Connect",
  "description": "把 AtomGit AtomCode 的 CodingPlan 模型接进 DeepSeek Harness：复用 `atomcode login` 的登录态，本机回环代理负责网关请求签名。",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "atomgit",
    "atomcode",
    "codingplan",
    "model-provider"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "external": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-llm-pi-ai": "*",
    "@deepseek-ai/schemastery": "*",
    "@earendil-works/pi-ai": "*"
  },
  "scripts": {
    "test": "node --test test/sign.test.mjs",
    "smoke": "node test/smoke-shim.mjs",
    "smoke:client": "node test/smoke-client.mjs"
  },
  "license": "MIT",
  "author": "wellsoren",
  "repository": {
    "type": "git",
    "url": "https://github.com/wellsoren/dsh-atomcode.git"
  },
  "homepage": "https://github.com/wellsoren/dsh-atomcode#readme",
  "bugs": {
    "url": "https://github.com/wellsoren/dsh-atomcode/issues"
  }
}
